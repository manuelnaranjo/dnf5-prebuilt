module(
    name = "dnf5_prebuilt",
    version = "0.0.1",
)

# resolver and frontend
bazel_dep(name = "dnf5", version = "5.4.0.bcr.1")

# rpm2cpio and rpm2archive
bazel_dep(name = "rpm", version = "6.0.1.bcr.2")

# needed to set which ssl lib to use
bazel_dep(name = "curl", version = "8.12.0")

# RBE toolchain
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
buildbuddy.platform(buildbuddy_container_image = "UBUNTU24_04_IMAGE")

register_toolchains(
    "@toolchains_buildbuddy//toolchains/cc:ubuntu_gcc_x86_64",
)

# hermetic c/c++ toolchain
bazel_dep(name = "llvm", version = "0.6.9")

register_toolchains("@llvm//toolchain:all")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1")

# rules_rust only reads rust.toolchain() from the root module (rpm-sequoia's
# call is ignored as a non-root module).  Re-declare here so that we can add
# extra_exec_rustc_flags: Rust 1.85+ defaults to the self-contained linker on
# x86_64-unknown-linux-gnu, but the downloaded toolchain does not bundle
# rust-lld, so we must disable it.
bazel_dep(name = "rules_rust", version = "0.69.0", dev_dependency = True)

# Rust toolchain — pin to minimum supported version (1.85)
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
