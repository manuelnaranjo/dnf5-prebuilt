load("@rules_cc//cc:defs.bzl", "cc_library")
load("@bazel_skylib//rules:write_file.bzl", "write_file")

# config.h is generated here (not at the workspace root) so that
# includes = ["."] adds bazel-out/.../bin/config/ to -I, making
# #include <config.h> resolve to this generated file.
write_file(
    name = "gen_config_h",
    out = "config.h",
    visibility = ["//visibility:public"],
    content = [
        "#ifndef HAVE_CONFIG_H",
        "#define HAVE_CONFIG_H 1",
        "",
        "/* Enable GNU extensions (glibc: memrchr, strerror_r, etc.) */",
        "#define _GNU_SOURCE 1",
        "",
        "#define PACKAGE_VERSION \"1.60\"",
        "#define PACKAGE_NAME \"libgpg-error\"",
        "#define PACKAGE_STRING \"libgpg-error 1.60\"",
        "#define PACKAGE_BUGREPORT \"https://bugs.gnupg.org\"",
        "#define PACKAGE_URL \"\"",
        "#define PACKAGE \"libgpg-error\"",
        "",
        "/* sizeof() values — 64-bit platforms (Linux/macOS amd64, arm64, s390x) */",
        "#define SIZEOF_INT       4",
        "#define SIZEOF_LONG      8",
        "#define SIZEOF_LONG_LONG 8",
        "",
        "/* Headers */",
        "#define HAVE_STDINT_H 1",
        "#define HAVE_SYS_TYPES_H 1",
        "#define HAVE_LOCALE_H 1",
        "#define HAVE_POLL_H 1",
        "#define HAVE_SYS_SELECT_H 1",
        "#define HAVE_SIGNAL_H 1",
        "#define HAVE_SYS_TIME_H 1",
        "#define HAVE_PWD_H 1",
        "",
        "/* Functions */",
        "#define HAVE_STRERROR_R 1",
        "#define HAVE_FLOCKFILE 1",
        "#define HAVE_SETENV 1",
        "#define HAVE_STAT 1",
        "#define HAVE_GETPWNAM 1",
        "#define HAVE_GETPWUID 1",
        "#define HAVE_GETPWNAM_R 1",
        "#define HAVE_GETPWUID_R 1",
        "#define HAVE_GETRLIMIT 1",
        "#define HAVE_INET_PTON 1",
        "#define HAVE_EXPLICIT_BZERO 1",
        "#define HAVE_MEMRCHR 1",
        "",
        "/* Types */",
        "#define HAVE_LONG_DOUBLE 1",
        "#define HAVE_LONG_LONG_INT 1",
        "#define HAVE_INTMAX_T 1",
        "#define HAVE_UINTMAX_T 1",
        "#define HAVE_PTRDIFF_T 1",
        "",
        "/* Threading */",
        "#define USE_POSIX_THREADS 1",
        "",
        "/* mkheader needs this to define gpgrt_off_t */",
        "#define REPLACEMENT_FOR_OFF_T \"int64_t\"",
        "",
        "/* Build paths */",
        "#define SYSCONFDIR \"/etc\"",
        "#define LOCALEDIR \"/usr/share/locale\"",
        "",
        "/* Build metadata (informational only) */",
        "#define BUILD_COMMITID \"\"",
        "#define BUILD_TIMESTAMP \"\"",
        "",
        "/* Internal-only macros required to build the library itself.",
        " * These are undef-ed in tests/t-version.c to avoid accidental",
        " * leakage into the public API. */",
        "#define _ESTREAM_PRINTF_EXTRA_INCLUDE \"gpgrt-int.h\"",
        "#define GPG_ERR_ENABLE_GETTEXT_MACROS 1",
        "#define GPGRT_ENABLE_ES_MACROS 1",
        "#define GPGRT_ENABLE_LOG_MACROS 1",
        "#define GPGRT_ENABLE_ARGPARSE_MACROS 1",
        "#define GPGRT_STD_COPYRIGHT_LINE \"Copyright (C) 2025 g10 Code GmbH\"",
        "",
        "/* Linux-only syscalls */",
        "#ifdef __linux__",
        "#define HAVE_CLOSEFROM 1",
        "#define HAVE_GETDENTS64 1",
        "#endif",
        "",
        "#endif /* HAVE_CONFIG_H */",
        "",
    ],
)

cc_library(
    name = "config",
    hdrs = [":gen_config_h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)
