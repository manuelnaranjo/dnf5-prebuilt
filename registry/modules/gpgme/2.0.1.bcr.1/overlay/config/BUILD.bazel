load("@rules_cc//cc:defs.bzl", "cc_library")
load("@bazel_skylib//rules:write_file.bzl", "write_file")

# config.h is generated here (not at the workspace root) so that
# includes = ["."] adds bazel-out/.../bin/config/ to -I, making
# #include <config.h> resolve to this generated file.
write_file(
    name = "gen_config_h",
    out = "config.h",
    content = [
        "#ifndef HAVE_CONFIG_H",
        "#define HAVE_CONFIG_H 1",
        "",
        "/* Enable GNU extensions (glibc: getline, strndup, etc.) */",
        "#ifndef _GNU_SOURCE",
        "#define _GNU_SOURCE 1",
        "#endif",
        "",
        "/* To allow the use of GPGME in multithreaded programs we have to use",
        "   special features from the library. */",
        "#ifndef _REENTRANT",
        "#define _REENTRANT 1",
        "#endif",
        "",
        "/* Package information */",
        "#define PACKAGE         \"gpgme\"",
        "#define PACKAGE_NAME    \"gpgme\"",
        "#define PACKAGE_VERSION \"2.0.2\"",
        "#define PACKAGE_STRING  \"gpgme 2.0.2\"",
        "#define PACKAGE_TARNAME \"gpgme\"",
        "#define PACKAGE_BUGREPORT \"https://bugs.gnupg.org\"",
        "#define PACKAGE_URL     \"\"",
        "#define VERSION         \"2.0.2\"",
        "",
        "/* Build metadata (informational only) */",
        "#define BUILD_COMMITID  \"\"",
        "#define BUILD_REVISION  \"\"",
        "#define BUILD_TIMESTAMP \"\"",
        "",
        "/* The default error source for GPGME. */",
        "#define GPG_ERR_SOURCE_DEFAULT GPG_ERR_SOURCE_GPGME",
        "",
        "/* Under Windows we use the gettext code from gpgrt. */",
        "#define GPG_ERR_ENABLE_GETTEXT_MACROS 1",
        "",
        "/* version of the libassuan library */",
        "#define GPGME_LIBASSUAN_VERSION \"3.0.3\"",
        "",
        "/* Requested API version for libassuan */",
        "#define LIBASSUAN_API_REQUESTED 2",
        "",
        "/* sizeof(unsigned int) on 32/64-bit platforms */",
        "#define SIZEOF_UNSIGNED_INT 4",
        "",
        "/* C99 flexible array members are supported */",
        "#define FLEXIBLE_ARRAY_MEMBER  /* empty */",
        "",
        "/* Separators as used in $PATH and file name (POSIX). */",
        "#define PATHSEP_C ':'",
        "#define DIRSEP_C  '/'",
        "#define DIRSEP_S  \"/\"",
        "",
        "/* GCC pure attribute */",
        "#if __GNUC__ > 2",
        "# define GPGME_GCC_A_PURE  __attribute__ ((__pure__))",
        "#else",
        "# define GPGME_GCC_A_PURE",
        "#endif",
        "",
        "#define CRIGHTBLURB \"Copyright (C) 2000 Werner Koch\\n\" \\",
        "                    \"Copyright (C) 2001--2025 g10 Code GmbH\\n\"",
        "",
        "#ifdef __linux__",
        "/* Standard POSIX headers present on Linux. */",
        "#define HAVE_DLFCN_H 1",
        "#define HAVE_INTTYPES_H 1",
        "#define HAVE_LOCALE_H 1",
        "#define HAVE_POLL_H 1",
        "#define HAVE_STDINT_H 1",
        "#define HAVE_STDIO_H 1",
        "#define HAVE_STDLIB_H 1",
        "#define HAVE_STRING_H 1",
        "#define HAVE_STRINGS_H 1",
        "#define HAVE_SYS_SELECT_H 1",
        "#define HAVE_SYS_STAT_H 1",
        "#define HAVE_SYS_TIME_H 1",
        "#define HAVE_SYS_TYPES_H 1",
        "#define HAVE_SYS_UIO_H 1",
        "#define HAVE_UNISTD_H 1",
        "#define HAVE_WCHAR_H 1",
        "#define STDC_HEADERS 1",
        "",
        "/* POSIX / glibc functions on Linux. */",
        "#define HAVE_FSEEKO 1",
        "#define HAVE_GETEGID 1",
        "/* HAVE_GETENV_R not defined: glibc does not have getenv_r */",
        "#define HAVE_GETGID 1",
        "#define HAVE_GETTID 1",
        "#define HAVE_NANOSLEEP 1",
        "#define HAVE_SETENV 1",
        "#define HAVE_SETLOCALE 1",
        "#define HAVE_STPCPY 1",
        "#define HAVE_TIMEGM 1",
        "#define HAVE_TTYNAME_R 1",
        "#define HAVE_DECL_TTYNAME_R 1",
        "#define HAVE_POSIXDECL_TTYNAME_R 1",
        "#define HAVE_TLS 1",
        "#define HAVE_SYS_GETTID 1",
        "#define HAVE_THREAD_SAFE_GETENV 1",
        "",
        "/* glibc >= 2.34 provides closefrom(2) */",
        "#define HAVE_CLOSEFROM 1",
        "",
        "/* struct cmsghdr.cmsg_len is present on Linux — enable descriptor passing. */",
        "#define USE_DESCRIPTOR_PASSING 1",
        "",
        "/* Enable the UI server (requires descriptor passing + libassuan). */",
        "#define ENABLE_UISERVER 1",
        "",
        "/* Use SYS_getdents on Linux to optimise fd-closing before exec. */",
        "#define USE_LINUX_GETDENTS 1",
        "",
        "#elif defined(__APPLE__)",
        "/* Standard POSIX headers present on macOS. */",
        "#define HAVE_DLFCN_H 1",
        "#define HAVE_INTTYPES_H 1",
        "#define HAVE_LOCALE_H 1",
        "#define HAVE_POLL_H 1",
        "#define HAVE_STDINT_H 1",
        "#define HAVE_STDIO_H 1",
        "#define HAVE_STDLIB_H 1",
        "#define HAVE_STRING_H 1",
        "#define HAVE_STRINGS_H 1",
        "#define HAVE_SYS_SELECT_H 1",
        "#define HAVE_SYS_STAT_H 1",
        "#define HAVE_SYS_TIME_H 1",
        "#define HAVE_SYS_TYPES_H 1",
        "#define HAVE_SYS_UIO_H 1",
        "#define HAVE_UNISTD_H 1",
        "#define HAVE_WCHAR_H 1",
        "#define STDC_HEADERS 1",
        "",
        "/* POSIX functions on macOS. */",
        "#define HAVE_FSEEKO 1",
        "#define HAVE_GETEGID 1",
        "#define HAVE_GETGID 1",
        "#define HAVE_NANOSLEEP 1",
        "#define HAVE_SETENV 1",
        "#define HAVE_SETLOCALE 1",
        "#define HAVE_STPCPY 1",
        "#define HAVE_TIMEGM 1",
        "#define HAVE_TTYNAME_R 1",
        "#define HAVE_DECL_TTYNAME_R 1",
        "#define HAVE_POSIXDECL_TTYNAME_R 1",
        "#define HAVE_TLS 1",
        "",
        "/* macOS platform flag */",
        "#define HAVE_MACOS_SYSTEM 1",
        "",
        "/* struct cmsghdr.cmsg_len is present on macOS — enable descriptor passing. */",
        "#define USE_DESCRIPTOR_PASSING 1",
        "",
        "/* Enable the UI server (requires descriptor passing + libassuan). */",
        "#define ENABLE_UISERVER 1",
        "",
        "#endif /* __linux__ / __APPLE__ */",
        "",
        "#endif /* HAVE_CONFIG_H */",
        "",
    ],
)

cc_library(
    name = "config",
    hdrs = [":gen_config_h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)
