load("@bazel_skylib//rules:write_file.bzl", "write_file")
load(":nettle_gen.bzl", "des_header", "ecc_header")

# ---------------------------------------------------------------------------
# config.h — written by hand, no autoconf
# WORDS_BIGENDIAN is only defined on big-endian targets (s390x)
# Never write "#define HAVE_FOO 0" — #ifdef treats any definition (incl. 0) as true
# ---------------------------------------------------------------------------
write_file(
    name = "config_h",
    out = "config.h",
    content = [
        "/* Bazel-generated config.h for nettle 3.10.2 (s390x, big-endian) */",
        "#ifndef NETTLE_CONFIG_H_INCLUDED",
        "#define NETTLE_CONFIG_H_INCLUDED",
        "#define WITH_HOGWEED 1",
        "#define HAVE_NATIVE_64_BIT 1",
        "#define HAVE_BUILTIN_BSWAP64 1",
        "#define HAVE_BUILTIN_BSWAP32 1",
        "#define HAVE_ALLOCA 1",
        "#define HAVE_GETLINE 1",
        "#define PACKAGE_NAME \"nettle\"",
        "#define PACKAGE_VERSION \"3.10.2\"",
        "#define PACKAGE_STRING \"nettle 3.10.2\"",
    ] + select({
        "@platforms//cpu:s390x": [
            "#define WORDS_BIGENDIAN 1",
        ],
        "//conditions:default": [],
    }) + [
        "#define HAVE_GCC_ATTRIBUTE 1",
        "#if defined(__GNUC__) && HAVE_GCC_ATTRIBUTE",
        "# define NORETURN __attribute__ ((__noreturn__))",
        "# define PRINTF_STYLE(f, a) __attribute__ ((__format__ (__printf__, f, a)))",
        "# define UNUSED __attribute__ ((__unused__))",
        "#else",
        "# define NORETURN",
        "# define PRINTF_STYLE(f, a)",
        "# define UNUSED",
        "#endif",
        "#endif /* NETTLE_CONFIG_H_INCLUDED */",
    ],
)

# ---------------------------------------------------------------------------
# version.h — generated from template
# ---------------------------------------------------------------------------
expand_template(
    name = "version_h",
    out = "version.h",
    substitutions = {
        "@MAJOR_VERSION@": "3",
        "@MINOR_VERSION@": "10",
        "@NETTLE_USE_MINI_GMP@": "0",
        "@GMP_NUMB_BITS@": "64",
    },
    template = "version.h.in",
)

# ---------------------------------------------------------------------------
# Host tools for generating ECC and DES tables
# ---------------------------------------------------------------------------
# eccdata.c textually includes mini-gmp.c — use a library with textual_hdrs
# so mini-gmp.c is in the sandbox but NOT compiled as a separate TU
cc_library(
    name = "mini_gmp_textual",
    textual_hdrs = [
        "mini-gmp.c",
        "mini-gmp.h",
    ],
    visibility = ["//visibility:private"],
)

cc_binary(
    name = "eccdata",
    srcs = ["eccdata.c"],
    visibility = ["//visibility:private"],
    deps = [":mini_gmp_textual"],
)

cc_binary(
    name = "desdata",
    srcs = [
        "desdata.c",
        "desinfo.h",
    ],
    visibility = ["//visibility:private"],
)

