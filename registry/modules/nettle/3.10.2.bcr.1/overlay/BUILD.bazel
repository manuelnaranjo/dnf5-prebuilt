# ---------------------------------------------------------------------------
# Bare-access header library (no include_prefix) for internal tools/tests
# that include headers with bare filenames like #include "aes.h"
# ---------------------------------------------------------------------------
cc_library(
    name = "nettle_hdrs",
    hdrs = NETTLE_PUBLIC_HDRS + HOGWEED_PUBLIC_HDRS + [
        ":config_h",
        ":version_h",
    ],
    visibility = [
        "//testsuite:__pkg__",
        "//tools:__pkg__",
    ],
)

# Internal headers needed by the testsuite
cc_library(
    name = "nettle_test_support",
    hdrs = [
        "ecc-internal.h",
        "gmp-glue.h",
        "nettle-internal.h",
    ],
    deps = ["@gmp//:gmp"],
    visibility = ["//testsuite:__pkg__"],
)

# ---------------------------------------------------------------------------
# getopt — used by tools
# ---------------------------------------------------------------------------
cc_library(
    name = "getopt",
    srcs = [
        "getopt.c",
        "getopt1.c",
    ],
    hdrs = [
        "getopt.h",
        "getopt_int.h",
    ],
    # Do NOT define HAVE_CONFIG_H here: getopt.c uses #include <config.h>
    # with angle brackets which would require config.h on the -I path.
    # Without the define, getopt skips the include and uses its own fallbacks.
    visibility = ["//tools:__pkg__"],
)

# ---------------------------------------------------------------------------
# non-nettle — cipher test helper used by testsuite
# ---------------------------------------------------------------------------
cc_library(
    name = "non_nettle",
    srcs = ["non-nettle.c"],
    hdrs = ["non-nettle.h"],
    defines = ["HAVE_CONFIG_H"],
    visibility = ["//testsuite:__pkg__"],
    deps = [":nettle_hdrs"],
)

