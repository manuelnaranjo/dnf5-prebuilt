load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//:config.bzl", "write_rpm_config_h")

write_rpm_config_h(name = "config_h")

genrule(
    name = "tagtbl_inc",
    srcs = ["include/rpm/rpmtag.h"],
    outs = ["lib/tagtbl.inc"],
    cmd = "AWK=awk $(location lib/gentagtbl.sh) $< > $@",
    tools = ["lib/gentagtbl.sh"],
)


cc_library(
    name = "misc_headers",
    hdrs = glob(["misc/*.h"]),
    includes = ["misc"],
)

cc_library(
    name = "librpmio",
    srcs = [
        "rpmio/argv.cc",
        "rpmio/base64.cc",
        "rpmio/digest.cc",
        "rpmio/expression.cc",
        "rpmio/lposix.cc",
        "rpmio/macro.cc",
        "rpmio/progname.cc",
        "rpmio/rgetopt.cc",
        "rpmio/rpmfileutil.cc",
        "rpmio/rpmglob.cc",
        "rpmio/rpmhook.cc",
        "rpmio/rpmio.cc",
        "rpmio/rpmkeyring.cc",
        "rpmio/rpmlog.cc",
        "rpmio/rpmlua.cc",
        "rpmio/rpmmalloc.cc",
        "rpmio/rpmpgp.cc",
        "rpmio/rpmpgp_sequoia.cc",
        "rpmio/rpmsq.cc",
        "rpmio/rpmstring.cc",
        "rpmio/rpmstrpool.cc",
        "rpmio/rpmsw.cc",
        "rpmio/rpmver.cc",
        "rpmio/rpmvercmp.cc",
        "rpmio/url.cc",
        "rpmio/rpmio_internal.hh",
        "rpmio/rpmpgpval.hh",
        "rpmio/rpmmacro_internal.hh",
        "rpmio/rpmlua.hh",
        "rpmio/rpmhook.hh",
        "rpmio/lposix.hh",
        "config.h",
    ],
    hdrs = glob(["include/rpm/*.h"]),
    # modemuncher.cc is #included by lposix.cc, not compiled separately
    textual_hdrs = ["rpmio/modemuncher.cc"],
    copts = [
        "-std=gnu++23",
        "-I.",
        "-Iinclude/",
        "-Imisc/",
        "-Irpmio/",
        "-Wno-sign-compare",
        "-fpermissive",
    ],
    local_defines = [
        "_GNU_SOURCE",
        "_FILE_OFFSET_BITS=64",
        "HAVE_CONFIG_H",
        "RPM_CONFIGDIR=\\\"/usr/lib/rpm\\\"",
        "HAVE___PROGNAME",
    ],
    linkopts = [
        "-lm",
    ],
    deps = [
        ":misc_headers",
        "@bzip2//:bz2",
        "@lua",
        "@openssl//:crypto",
        "@popt",
        "@rpm-sequoia//:rpm_sequoia",
        "@xz//:lzma",
        "@zlib",
        "@zstd",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

