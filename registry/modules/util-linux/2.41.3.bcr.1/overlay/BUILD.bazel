    name = "config_h",
    out = "config.h",
    substitutions = {
        "@PACKAGE@": PACKAGE,
        "@PACKAGE_VERSION@": PACKAGE_VERSION,
        "@PACKAGE_STRING@": PACKAGE + " " + PACKAGE_VERSION,
        "@LIBBLKID_DATE@": LIBBLKID_DATE,
        "@_PATH_SYSCONFSTATICDIR@": "/usr/lib",
        "@_PATH_RUNSTATEDIR@": "/run",
        "@_PATH_LOCALSTATEDIR@": "/var",
        "@_PATH_VENDORDIR@": "",
        "@CONFIG_ADJTIME_PATH@": "/etc/adjtime",
        "@ADJTIME_PATH@": "/etc/adjtime",
        "@FS_SEARCH_PATH@": "/sbin:/bin:/usr/sbin:/usr/bin",
    },
    template = ":config_h_tmpl",
)

# cc_library that exposes config.h to all other targets.
# Dependents must also add -include config.h to their copts (done via COPTS
# in defs.bzl).  Bazel adds the output directory containing config.h to the
# compiler -iquote search path when this target is listed in deps.
cc_library(
    name = "config",
    hdrs = [":config_h"],
    visibility = ["//visibility:public"],
)
