# Simple tools — lib_common only
[
    cc_binary(
        name = name,
        srcs = [name + ".c"],
        copts = COPTS,
        visibility = ["//visibility:public"],
        deps = [
            "//:config",
            "//include:headers",
            "//lib:common",
        ],
    )
    for name in [
        "kill",
        "rename",
        "getopt",
        "pipesz",
        "fadvise",
        "waitpid",
        "exch",
    ]
]

# enosys requires generated syscalls.h + errnos.h (custom shell script targets); excluded.
# lsfd requires generated errnos.h (custom shell script target); excluded.
