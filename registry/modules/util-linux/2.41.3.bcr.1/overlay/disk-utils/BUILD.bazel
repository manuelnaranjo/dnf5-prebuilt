# addpart, delpart, resizepart — lib_common only
[
    cc_binary(
        name = name,
        srcs = [name + ".c"],
        copts = COPTS,
        visibility = ["//visibility:public"],
        deps = [
            "//:config",
            "//include:headers",
            "//lib:common",
        ],
    )
    for name in [
        "addpart",
        "delpart",
        "resizepart",
    ]
]

# partx — lib_common + libsmartcols + libblkid
cc_binary(
    name = "partx",
    srcs = ["partx.c"],
    copts = COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//:config",
        "//include:headers",
        "//lib:common",
        "//libblkid:libblkid",
        "//libsmartcols:libsmartcols",
    ],
)

