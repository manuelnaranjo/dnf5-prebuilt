    srcs = ["fsck.c"],
    copts = COPTS,
    linkopts = ["-lrt"],
    visibility = ["//visibility:public"],
    deps = [
        "//:config",
        "//include:headers",
        "//lib:common",
        "//libblkid:libblkid",
        "//libmount:libmount",
    ],
)

# mkfs.minix / fsck.minix — lib_common; ismounted_c is part of lib:common
