load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//:defs.bzl", "COPTS")

# mkfs — standalone, no lib_common
cc_binary(
    name = "mkfs",
    srcs = ["mkfs.c"],
    copts = COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//:config",
        "//include:headers",
    ],
)

# mkfs.bfs — lib_common only
cc_binary(
    name = "mkfs.bfs",
    srcs = ["mkfs.bfs.c"],
    copts = COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//:config",
        "//include:headers",
        "//lib:common",
    ],
)

# isosize — lib_common only
cc_binary(
