load("@rules_cc//cc:defs.bzl", "cc_library")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("//:defs.bzl", "COPTS", "LIBBLKID_DATE", "PACKAGE_VERSION")

# Generate the public blkid.h header from the in-tree template.
expand_template(
    name = "blkid_h",
    out = "blkid.h",
    substitutions = {
        "@LIBBLKID_VERSION@": PACKAGE_VERSION,
        "@LIBBLKID_DATE@": LIBBLKID_DATE,
    },
    template = "src/blkid.h.in",
)

# Header-only target so that lib:swapprober can depend on blkid.h
# without creating a circular dep (libblkid → lib:common → lib:swapprober → libblkid).
cc_library(
    name = "blkid_hdrs",
    hdrs = [":blkid_h"],
    # includes=["."] adds the package output dir to -I so #include <blkid.h> works.
    includes = ["."],
    visibility = ["//visibility:public"],
)

# libblkid — block device identification library.
# Mirrors the meson `lib_blkid` both_libraries target.
# Linux topology sources (dm.c, evms.c, …) are always included since we target Linux.
