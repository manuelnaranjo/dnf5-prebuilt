load("@rules_cc//cc:defs.bzl", "cc_library")
load("@bazel_skylib//rules:write_file.bzl", "write_file")

write_file(
    name = "gen_config_h",
    out = "config.h",
    content = [
        "#ifndef _ASSUAN_CONFIG_H_INCLUDED",
        "#define _ASSUAN_CONFIG_H_INCLUDED",
        "",
        "/* Provide the es_ macro for estream.  */",
        "#define GPGRT_ENABLE_ES_MACROS 1",
        "",
        "/* Enable GNU extensions (Linux/glibc).  */",
        "#ifndef _GNU_SOURCE",
        "#define _GNU_SOURCE 1",
        "#endif",
        "",
        "#ifdef __linux__",
        "/* Standard POSIX headers present on Linux.  */",
        "#define HAVE_FCNTL_H 1",
        "#define HAVE_INTTYPES_H 1",
        "#define HAVE_LOCALE_H 1",
        "#define HAVE_STDINT_H 1",
        "#define HAVE_SYS_SELECT_H 1",
        "#define HAVE_SYS_STAT_H 1",
        "#define HAVE_SYS_TIME_H 1",
        "#define HAVE_SYS_TYPES_H 1",
        "#define HAVE_SYS_UIO_H 1",
        "#define HAVE_UNISTD_H 1",
        "",
        "/* POSIX / glibc functions present on Linux.  */",
        "#define HAVE_FLOCKFILE 1",
        "#define HAVE_FUNLOCKFILE 1",
        "#define HAVE_GETADDRINFO 1",
        "#define HAVE_GETRLIMIT 1",
        "#define HAVE_INET_PTON 1",
        "#define HAVE_ISASCII 1",
        "#define HAVE_MEMRCHR 1",
        "#define HAVE_NANOSLEEP 1",
        "#define HAVE_SETENV 1",
        "#define HAVE_STAT 1",
        "#define HAVE_STPCPY 1",
        "",
        "/* Linux glibc provides fopencookie (not the BSD funopen).  The",
        "   funopen.c replacement implements funopen in terms of fopencookie.  */",
        "#define HAVE_FOPENCOOKIE 1",
        "",
        "/* struct cmsghdr.cmsg_len is present on Linux — enable descriptor passing.  */",
        "#define USE_DESCRIPTOR_PASSING 1",
        "#elif defined(__APPLE__)",
        "/* Standard POSIX headers present on macOS.  */",
        "#define HAVE_FCNTL_H 1",
        "#define HAVE_INTTYPES_H 1",
        "#define HAVE_LOCALE_H 1",
        "#define HAVE_STDINT_H 1",
        "#define HAVE_SYS_SELECT_H 1",
        "#define HAVE_SYS_STAT_H 1",
        "#define HAVE_SYS_TIME_H 1",
        "#define HAVE_SYS_TYPES_H 1",
        "#define HAVE_SYS_UIO_H 1",
        "#define HAVE_UNISTD_H 1",
        "",
        "/* POSIX functions present on macOS.  */",
        "#define HAVE_FLOCKFILE 1",
        "#define HAVE_FUNLOCKFILE 1",
        "#define HAVE_GETADDRINFO 1",
        "#define HAVE_GETRLIMIT 1",
        "#define HAVE_INET_PTON 1",
        "#define HAVE_ISASCII 1",
        "#define HAVE_MEMRCHR 1",
        "#define HAVE_NANOSLEEP 1",
        "#define HAVE_SETENV 1",
        "#define HAVE_STAT 1",
        "#define HAVE_STPCPY 1",
        "",
        "/* struct cmsghdr.cmsg_len is present on macOS — enable descriptor passing.  */",
        "#define USE_DESCRIPTOR_PASSING 1",
        "#endif /* __linux__ / __APPLE__ */",
        "",
        "/* Build information.  */",
        '#define PACKAGE "libassuan"',
        '#define PACKAGE_VERSION "3.0.3"',
        '#define VERSION "3.0.3"',
        '#define BUILD_REVISION ""',
        '#define BUILD_COMMITID ""',
        '#define BUILD_TIMESTAMP "<none>"',
        "",
        "#endif /*_ASSUAN_CONFIG_H_INCLUDED*/",
        ""
    ],
)

cc_library(
    name = "config",
    hdrs = ["config.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)