load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

# ---------------------------------------------------------------------------
# Platform config_settings for mkheader host_os triplet selection
# ---------------------------------------------------------------------------
[config_setting(
    name = name,
    constraint_values = constraints,
) for name, constraints in {
    "linux_x86_64":  ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    "linux_aarch64": ["@platforms//os:linux", "@platforms//cpu:aarch64"],
    "linux_s390x":   ["@platforms//os:linux", "@platforms//cpu:s390x"],
    "macos_x86_64":  ["@platforms//os:osx",   "@platforms//cpu:x86_64"],
    "macos_aarch64": ["@platforms//os:osx",   "@platforms//cpu:aarch64"],
}.items()]

# ---------------------------------------------------------------------------
# Build-time host tool: generates assuan.h from assuan.h.in
# Built for the exec (build host) platform automatically when used as a tool.
# ---------------------------------------------------------------------------
cc_binary(
    name = "mkheader_tool",
    srcs = ["mkheader.c"],
)

# ---------------------------------------------------------------------------
# assuan.h — generated from assuan.h.in + posix/w32 inc fragments
#
# mkheader derives srcdir from the path of assuan.h.in, then opens
# posix-*.inc.h (or w32-*.inc.h for mingw32) from that same directory.
# All fragments are listed in srcs so Bazel makes them available in the
# sandbox at their workspace-relative paths.
# ---------------------------------------------------------------------------
_MKHEADER = "$(execpath :mkheader_tool)"
_TMPL     = "$(location assuan.h.in)"
_VER      = "3.0.3 0x030003"

genrule(
    name = "gen_assuan_h",
    srcs = [
        "assuan.h.in",
        "posix-includes.inc.h",
        "posix-types.inc.h",
        "posix-fd-t.inc.h",
        "posix-sock-nonce.inc.h",
        "w32-includes.inc.h",
        "w32-types.inc.h",
        "w32-fd-t.inc.h",
        "w32-sock-nonce.inc.h",
    ],
    outs = ["assuan.h"],
    tools = [":mkheader_tool"],
    cmd = select({
        ":linux_x86_64":  "{} x86_64-unknown-linux-gnu  {} {} > $@".format(_MKHEADER, _TMPL, _VER),
        ":linux_aarch64": "{} aarch64-unknown-linux-gnu {} {} > $@".format(_MKHEADER, _TMPL, _VER),
        ":linux_s390x":   "{} s390x-unknown-linux-gnu   {} {} > $@".format(_MKHEADER, _TMPL, _VER),
        ":macos_x86_64":  "{} x86_64-apple-darwin       {} {} > $@".format(_MKHEADER, _TMPL, _VER),
        ":macos_aarch64": "{} aarch64-apple-darwin       {} {} > $@".format(_MKHEADER, _TMPL, _VER),
    }),
)

# ---------------------------------------------------------------------------
# libassuan — main IPC library
#
# Source list mirrors src/Makefile.am common_sources + assuan-io.c.
# system-posix.c is used on POSIX (Linux/macOS); system-w32.c is omitted.
# funopen.c is compiled on Linux where glibc has fopencookie but not funopen
# (controlled by HAVE_FOPENCOOKIE in config.h).
# Replacement functions isascii.c/memrchr.c/stpcpy.c/setenv.c are NOT
# included because Linux glibc provides all of them natively.
# ---------------------------------------------------------------------------
_LIB_SRCS = [
    "assuan.c",
    "context.c",
    "system.c",
    "debug.c",
    "debug.h",
    "conversion.c",
    "sysutils.c",
    "client.c",
    "server.c",
    "assuan-error.c",
    "assuan-buffer.c",
    "assuan-handler.c",
    "assuan-inquire.c",
    "assuan-listen.c",
    "assuan-pipe-server.c",
    "assuan-socket-server.c",
    "assuan-pipe-connect.c",
    "assuan-socket-connect.c",
    "assuan-uds.c",
    "assuan-logging.c",
    "assuan-socket.c",
    "system-posix.c",
    "assuan-io.c",
    "funopen.c",     # implements funopen via fopencookie (HAVE_FOPENCOOKIE)
    "assuan-defs.h", # private internal header
]

cc_library(
    name = "libassuan",
    srcs = _LIB_SRCS,
    hdrs = [":gen_assuan_h"],
    # includes = ["."] adds both the source dir and the genfiles dir to -I,
    # propagated to all dependents.  This makes #include "assuan.h" find the
    # generated header and #include "assuan-defs.h" find the source header.
    includes = ["."],
    copts = [
        "-include",
        "config.h",
    ],
    deps = [
        "//config:config",
        "@libgpg-error//src:libgpg_error",
    ],
    visibility = ["//visibility:public"],
)
